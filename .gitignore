# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments (uv)
.venv/
venv/
env/

# Environment & secrets
.env
.env.local
*.env

# Type checking & linting caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Database
*.sqlite3
*.db
*.db-shm
*.db-wal

# macOS
.DS_Store
.AppleDouble

# IDE
.idea/
*.swp
*.swo

# Node (frontend, à venir)
node_modules/
frontend/dist/

# Tauri (desktop shell)
frontend/src-tauri/target/

# GitHub Actions
.github/workflows/*.log
# Journaux du backend, rotation comprise (tessera.log.1, .2…) : `*.log` ne
# couvre pas les fichiers tournés, et un run les a commités (ticket-330).
backend/logs/

# Workspace Tessera : les projets importés, clonés ou créés via l'IDE
# atterrissent dans projects/. Seul `ide-core` (le projet bootstrap) est
# versionné avec le dépôt — les autres appartiennent à l'utilisateur et ne
# doivent jamais être committés ici. C'est aussi ce qui empêche le
# `git add -A` de GitWorkspaceService de les balayer dans un commit de ticket.
projects/*
!projects/ide-core/

# Scratch des agents (plans, diffs de revue, rapports intermédiaires)
.superpowers/

# Logs de lancement locaux
*.log

# Fichier de journal tournant du backend (ticket-330)
backend/logs/

# Claude Code : la config partagée (skills, settings.json) est versionnée,
# les préférences personnelles ne le sont pas.
.claude/settings.local.json

# Artefacts de couverture (générés par pytest-cov / vitest)
.coverage
coverage.xml
htmlcov/

# Projets détachés de l'IDE. La destination est désormais hors du dépôt
# (ticket-078), mais un dossier créé avant ce correctif peut traîner ici : il
# ne doit en aucun cas partir dans un commit.
tessera-detaches/


# Marqueur de la doc par lot (ADR-035) : réécrit par chaque run, il salissait
# l arbre et bloquait le rebase de la livraison (ticket-213).
projects/ide-core/memory/documentation.json
