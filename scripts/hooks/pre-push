#!/usr/bin/env python3
"""pre-push hook: blocks pushes containing forbidden terms (ADR-048).

Run `make install-hooks` after cloning to activate this hook.
Git runs this script before every push; it exits 1 to abort.

The list is read through the backend (ADR-073): environment, system vault,
then .env, the same order as the settings. Standard library only.
"""
from __future__ import annotations

import re
import subprocess
import sys
import unicodedata
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

NULL_SHA = "0" * 40

#: Délai de la lecture par le backend : `uv run` peut synchroniser l'env d'abord.
DELAI_LECTURE_S = 120

_REFUS_LECTURE = (
    "Lecture des termes interdits impossible : push refusé. Lance `uv sync` dans "
    "backend/, ou déclare SECRETS_SOURCE=env (FORBIDDEN_TERMS dans l'environnement "
    "ou .env)."
)


class LectureImpossible(Exception):
    """The backend could not say which terms are forbidden."""


@dataclass(frozen=True)
class CommitInfo:
    """Short SHA, message and author of a single commit."""

    sha7: str
    message: str
    auteur: str


@dataclass(frozen=True)
class Violation:
    """Location of a forbidden term — never the term itself."""

    source: str


def racine_du_depot() -> Path:
    """Return the repository root, deduced from this hook's own path.

    `scripts/hooks/pre-push` or `.git/hooks/pre-push`: two levels up either
    way. From a worktree, git runs the hook of the main checkout, whose
    backend reads the same vault.
    """
    return Path(__file__).resolve().parents[2]


def load_forbidden_terms(
    racine: Path, lancer: Callable[..., "subprocess.CompletedProcess[str]"] = subprocess.run
) -> list[str]:
    """Ask the backend for FORBIDDEN_TERMS, normalized.

    Exit 0 with an empty output: no list declared, no local control. Any
    other failure raises LectureImpossible: a control that cannot judge lets
    nothing through.
    """
    commande = [
        "uv", "run", "--project", str(racine / "backend"),
        "python", "-m", "tessera.coffre_cli", "termes",
    ]
    try:
        resultat = lancer(
            commande, capture_output=True, text=True, encoding="utf-8",
            errors="replace", timeout=DELAI_LECTURE_S, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        raise LectureImpossible from None
    if resultat.returncode != 0:
        raise LectureImpossible
    return [_normaliser(t.strip()) for t in resultat.stdout.split(",") if t.strip()]


def _normaliser(texte: str) -> str:
    """Normalize text for term comparison (mirrors TermesInterditsService)."""
    nfkd = unicodedata.normalize("NFKD", texte.lower())
    sans_accents = "".join(c for c in nfkd if unicodedata.category(c) != "Mn")
    return re.sub(r"[-_.]", " ", sans_accents)


def _build_patterns(termes: list[str]) -> list[re.Pattern[str]]:
    """Compile word-boundary patterns for each normalized term."""
    return [re.compile(r"\b" + re.escape(t) + r"\b") for t in termes]


def _contient_terme(texte: str, patterns: list[re.Pattern[str]]) -> bool:
    normalise = _normaliser(texte)
    return any(p.search(normalise) for p in patterns)


def verifier(
    *,
    commits: list[CommitInfo],
    lignes_ajoutees: list[str],
    patterns: list[re.Pattern[str]],
) -> list[Violation]:
    """Find forbidden terms in commits and diff lines.

    Returns a list of Violation. An empty list means no violations found.
    ``lignes_ajoutees`` must contain all lines starting with ``+`` from the
    unified diff, including ``+++ b/<path>`` headers used to identify files.
    One violation per file and per commit at most.
    """
    if not patterns:
        return []

    violations: list[Violation] = []

    chemin_courant: str | None = None
    fichiers_signales: set[str | None] = set()

    for ligne in lignes_ajoutees:
        if ligne.startswith("+++"):
            chemin_courant = (
                ligne[6:].strip() if ligne.startswith("+++ b/") else None
            )
            continue
        if chemin_courant in fichiers_signales:
            continue
        contenu = ligne[1:] if ligne else ""
        if _contient_terme(contenu, patterns):
            fichiers_signales.add(chemin_courant)
            source = f"file:{chemin_courant}" if chemin_courant else "file:unknown"
            violations.append(Violation(source=source))

    commits_signales: set[str] = set()
    for commit in commits:
        if commit.sha7 in commits_signales:
            continue
        if _contient_terme(commit.message, patterns) or _contient_terme(
            commit.auteur, patterns
        ):
            commits_signales.add(commit.sha7)
            violations.append(Violation(source=f"commit:{commit.sha7}"))

    return violations


#: Nom et adresse de l'auteur ET du committer, puis le message complet : un
#: committer mal configuré publie son adresse autant qu'un auteur.
_FORMAT = "--format=%H%x1f%an <%ae> | %cn <%ce>%x1f%B%x1e"


def _git(cmd: list[str]) -> str:
    """Run git and return its UTF-8 output; a failure raises.

    Un contrôle qui n'a pas pu lire ce qui part ne laisse rien passer.
    """
    return subprocess.run(
        cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", check=True
    ).stdout


def _get_commits(local_sha: str, remote_sha: str) -> list[CommitInfo]:
    """Get commits in the push range via git log.

    When remote_sha is the null SHA (new branch), inspects all local commits
    not yet on any remote instead of using a range that would include it.
    """
    if remote_sha == NULL_SHA:
        cmd = ["git", "log", _FORMAT, local_sha, "--not", "--remotes"]
    else:
        cmd = ["git", "log", _FORMAT, f"{remote_sha}..{local_sha}"]

    commits: list[CommitInfo] = []
    for bloc in _git(cmd).split(""):
        parts = bloc.strip().split("", 2)
        if len(parts) == 3:
            sha, auteur, message = parts
            commits.append(CommitInfo(sha7=sha[:7], message=message.strip(), auteur=auteur))
    return commits


def _get_diff_lines(local_sha: str, remote_sha: str) -> list[str]:
    """Get added lines from the push diff via git.

    When remote_sha is the null SHA (new branch), uses git log -p to retrieve
    patches for commits not yet on any remote.
    """
    if remote_sha == NULL_SHA:
        cmd = ["git", "log", "-p", "--not", "--remotes", local_sha]
    else:
        cmd = ["git", "diff", f"{remote_sha}..{local_sha}"]

    return [line for line in _git(cmd).splitlines() if line.startswith("+")]


def main() -> int:
    """Entry point called by git before a push."""
    try:
        termes = load_forbidden_terms(racine_du_depot())
    except LectureImpossible:
        print(_REFUS_LECTURE, file=sys.stderr)
        return 1

    if not termes:
        return 0

    patterns = _build_patterns(termes)
    all_violations: list[Violation] = []

    for raw_line in sys.stdin:
        parts = raw_line.strip().split()
        if len(parts) < 4:
            continue
        _local_ref, local_sha, _remote_ref, remote_sha = parts[:4]

        if local_sha == NULL_SHA:
            # Branch deletion: nothing to push, nothing to check.
            continue

        try:
            commits = _get_commits(local_sha, remote_sha)
            diff_lines = _get_diff_lines(local_sha, remote_sha)
        except subprocess.CalledProcessError:
            print("Contrôle des termes interdits impossible : push refusé.", file=sys.stderr)
            return 1
        violations = verifier(
            commits=commits, lignes_ajoutees=diff_lines, patterns=patterns
        )
        all_violations.extend(violations)

    if all_violations:
        for v in all_violations:
            print(f"Terme interdit détecté : {v.source}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
