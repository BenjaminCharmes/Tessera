{
  // Le dossier du venv, pas son interpréteur : `bin/python` n'existe que sur
  // POSIX, `Scripts/python.exe` que sous Windows, et le dépôt sert sur les deux.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv",
  "python.terminal.activateEnvironment": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "python.analysis.extraPaths": ["${workspaceFolder}/backend/src"],
  "python.analysis.typeCheckingMode": "basic"
}
