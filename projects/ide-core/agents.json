{
  "project_id": "ide-core",
  "artifacts": "tracked",
  "git_root": "ancestor",
  "services": [
    {
      "nom": "backend",
      "commande": "uv run python -m uvicorn tessera.main:app --host 127.0.0.1 --port 8000",
      "cwd": "../../backend"
    },
    {
      "nom": "frontend",
      "commande": "npm run dev",
      "cwd": "../../frontend"
    }
  ],
  "agents": [
    {
      "role": "codeur",
      "model": "claude-sonnet-4-6",
      "max_tokens": 8192,
      "prompt_file": "agents/prompts/codeur.md",
      "active": true,
      "skills": [
        "verifier-mon-travail"
      ]
    },
    {
      "role": "reviewer",
      "model": "claude-sonnet-4-6",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/reviewer.md",
      "active": true
    },
    {
      "role": "architect",
      "model": "claude-sonnet-4-6",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/architect.md",
      "active": true,
      "web": true
    },
    {
      "role": "securite",
      "model": "claude-haiku-4-5",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/securite.md",
      "active": true,
      "provider": "agent_sdk"
    },
    {
      "role": "validateur",
      "model": "qwen3-coder:30b",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/validateur.md",
      "active": true,
      "provider": "ollama",
      "fallback": {
        "provider": "agent_sdk",
        "model": "claude-haiku-4-5"
      }
    },
    {
      "role": "doc-technique",
      "model": "claude-haiku-4-5",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/doc-technique.md",
      "active": true,
      "provider": "agent_sdk"
    },
    {
      "role": "doc-fonctionnelle",
      "model": "claude-haiku-4-5",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/doc-fonctionnelle.md",
      "active": true,
      "provider": "agent_sdk"
    },
    {
      "role": "project-analyzer",
      "model": "qwen3-coder:30b",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/project-analyzer.md",
      "active": true,
      "provider": "ollama",
      "fallback": {
        "provider": "agent_sdk",
        "model": "claude-sonnet-4-6"
      }
    }
  ],
  "pipeline": {
    "default": [
      "codeur",
      "reviewer"
    ],
    "max_review_rounds": 3,
    "testeur_enabled": true,
    "test_command": "uv run python -m pytest -q -x -m \"not integration\" -p no:cacheprovider",
    "test_cwd": "../../backend",
    "test_timeout_s": 600,
    "securite_enabled": true,
    "validateur_enabled": true,
    "doc_claude_md": true
  },
  "autonomy": "merge",
  "github_remote": "BenjaminCharmes/Tessera"
}
