{
  "project_id": "ide-core",
  "vibe_artifacts": "tracked",
  "git_root": "ancestor",
  "agents": [
    {
      "role": "codeur",
      "model": "claude-sonnet-4-6",
      "max_tokens": 8192,
      "prompt_file": "agents/prompts/codeur.md",
      "active": true,
      "max_instances": 2
    },
    {
      "role": "reviewer",
      "model": "claude-sonnet-4-6",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/reviewer.md",
      "active": true
    },
    {
      "role": "architect",
      "model": "claude-sonnet-4-6",
      "max_tokens": 4096,
      "prompt_file": "agents/prompts/architect.md",
      "active": true
    }
  ],
  "pipeline": {
    "default": [
      "codeur",
      "reviewer"
    ],
    "max_review_rounds": 3,
    "auto_merge_on_approve": true
  },
  "autonomy": "merge"
}
